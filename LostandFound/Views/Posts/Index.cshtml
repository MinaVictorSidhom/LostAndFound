@using LostAndFound.Core.Domain.Posts
@model IEnumerable<ItemPost>
@{ ViewData["Title"] = "Lost and Found"; }
<link rel="stylesheet" href="~/css/StyleSheet.css" />
<main class="feed-page"><header class="feed-header"><a class="feed-brand" asp-action="Index"><span class="brand-mark">⌕</span>Lost &amp; Found</a><nav>@if (User.Identity?.IsAuthenticated == true) { <a class="button-secondary" asp-action="MyPosts">My posts</a><a class="button-primary" asp-action="Create">Create report</a> } else { <a class="button-secondary" asp-controller="Account" asp-action="Login">Log in</a><a class="button-primary" asp-controller="Account" asp-action="Register">Create an account</a> }</nav></header>
<section class="feed-hero"><p class="eyebrow">Community reports</p><h1>Help belongings find their way home.</h1><p>Browse active lost and found reports. Owners and finders can connect safely through the selected contact preference.</p></section>
<section class="post-list" aria-label="Active reports">@if (!Model.Any()) { <p class="empty-state">No active reports yet. Be the first to post one.</p> } @foreach (var post in Model) { <article class="post-item"><div class="post-item-header"><span class="post-type @post.Type.ToString().ToLowerInvariant()">@post.Type</span><time datetime="@post.ItemDate.ToString("yyyy-MM-dd")">@post.ItemDate.ToString("dd MMM yyyy")</time></div><h2>@post.Title</h2><p class="post-meta">@post.Category · @post.Location</p><p>@post.Description</p>@if (post.Images.Any()) { <img class="post-photo" src="@post.Images.First().Path" alt="Photo of @post.Title" /> }<p class="contact-note">Contact: @post.ContactPreference.ToString().Replace("InAppMessagesOnly", "In-app messages only").Replace("Show", "Show ")</p></article> }</section>
</main>

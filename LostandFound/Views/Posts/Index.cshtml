@using LostAndFound.Core.Domain.Posts
@model IEnumerable<ItemPost>
@{
    ViewData["Title"] = "Lost and Found";
}
<link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />

<main class="feed-page">
    <header class="feed-header">
        <a class="feed-brand" asp-action="Index">
            <span class="brand-mark">⌕</span>Lost &amp; Found
        </a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="welcome-name">Hi, @((ViewBag.CurrentUserName as string) ?? User.Identity?.Name)</span>
                <partial name="_ThemeToggle" />
                <a class="button-secondary messages-nav" data-messages-nav data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" asp-action="Inbox"><span>Messages</span><span class="message-notification" data-message-count hidden aria-hidden="true"></span></a>
                <a class="button-secondary" asp-action="MyPosts">My posts</a>
                <a class="button-secondary" asp-controller="Account" asp-action="Profile">Profile</a>
            }
            else
            {
                <partial name="_ThemeToggle" />
                <a class="button-secondary" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="button-primary" asp-controller="Account" asp-action="Register">Create an account</a>
            }
        </nav>
    </header>

    <section class="feed-hero">
        <div>
            <p class="eyebrow">Your community lost &amp; found</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <h1>Good afternoon, @((ViewBag.CurrentUserName as string) ?? User.Identity?.Name).</h1>
            }
            else
            {
                <h1>Help belongings find their way home.</h1>
            }
            <p>A small detail can help someone find their way back to what matters.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="button-primary" asp-action="Create"><span aria-hidden="true">＋</span> Create a report</a>
        }
    </section>

    <section aria-label="Active reports">
        <div class="feed-section-heading">
            <div><h2>Recent reports</h2><p>Browse what people have lost or found nearby.</p></div>
        </div>
        <div class="post-list">
        @if (!Model.Any())
        {
            <p class="empty-state">No active reports yet. Be the first to post one.</p>
        }
        @foreach (var post in Model)
        {
            <article class="post-item">
                <div class="post-card-row">
                    @if (post.Images.Any())
                    {
                        <img class="post-photo" src="@post.Images.First().Path" alt="Photo of @post.Title" />
                    }
                    else
                    {
                        <div class="post-photo-placeholder" aria-hidden="true">⌕</div>
                    }
                    <div class="post-item-body">
                        <div class="post-item-header">
                            <span class="post-type @post.Type.ToString().ToLowerInvariant()">@post.Type item</span>
                            <time datetime="@post.ItemDate.ToString("yyyy-MM-dd")">@post.ItemDate.ToString("dd MMM yyyy")</time>
                        </div>
                        <h2>@post.Title</h2>
                        <p class="post-meta">@post.Category <span>·</span> @post.Location</p>
                        <p>@post.Description</p>
                        <p class="post-byline">Posted by @(string.IsNullOrWhiteSpace(post.User.PersonName) ? "Community member" : post.User.PersonName)</p>
                        @if (User.Identity?.IsAuthenticated != true || post.UserId.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <div class="post-contact-row">
                                @if (post.ContactPreference == ContactPreference.ShowPhone && !string.IsNullOrWhiteSpace(post.User.PhoneNumber))
                                {
                                    <span class="contact-note">Phone: <a href="tel:@post.User.PhoneNumber">@post.User.PhoneNumber</a></span>
                                    <a class="button-primary find-it-button" href="tel:@post.User.PhoneNumber">I find it <span aria-hidden="true">→</span></a>
                                }
                                else
                                {
                                    <span class="contact-note">Contact the poster privately</span>
                                    <a class="button-primary find-it-button" asp-action="Contact" asp-route-id="@post.Id">I find it <span aria-hidden="true">→</span></a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
        </div>
    </section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="~/js/messages.js" asp-append-version="true"></script>

@model IEnumerable<ItemPost>
@{
    ViewData["Title"] = "My reports";
}
<link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />

<main class="feed-page">
    <header class="feed-header">
        <a class="feed-brand" asp-action="Index">
            <span class="brand-mark">⌕</span>Lost &amp; Found
        </a>
        <nav>
            <partial name="_ThemeToggle" />
            <a class="button-secondary" asp-action="Inbox">Messages</a>
            <a class="button-primary" asp-action="Create">Create report</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                <button type="submit" class="link-button">Log out</button>
            </form>
        </nav>
    </header>

    <section class="feed-hero compact">
        <div>
            <p class="eyebrow">Your community reports</p>
            <h1>Your reports, @((ViewBag.CurrentUserName as string) ?? User.Identity?.Name).</h1>
            <p>Update a report when details change, or close it once the item is back where it belongs.</p>
        </div>
        <a class="button-primary" asp-action="Create"><span aria-hidden="true">＋</span> Create a report</a>
    </section>

    @if (TempData["Success"] is string success)
    {
        <p class="success-message" role="status">@success</p>
    }

    <section aria-label="Your reports">
      <div class="feed-section-heading"><div><h2>My posts</h2><p>Manage the reports you have shared.</p></div></div>
      <div class="post-list">
        @if (!Model.Any())
        {
            <p class="empty-state">You have not created any reports yet.</p>
        }
        @foreach (var post in Model)
        {
            <article class="post-item">
                <div class="post-item-header">
                    <span class="post-type @post.Type.ToString().ToLowerInvariant()">@post.Type</span>
                    <span class="status-tag">@post.Status</span>
                </div>
                <h2>@post.Title</h2>
                <p class="post-meta">@post.Category · @post.Location · @post.ItemDate.ToString("dd MMM yyyy")</p>
                <p>@post.Description</p>
                <div class="post-actions">
                    <a class="button-secondary" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
                    @if (post.Status == PostStatus.Active)
                    {
                        <form asp-action="Close" asp-route-id="@post.Id" method="post">
                            <input type="hidden" name="resolved" value="true" />
                            <button class="button-primary" type="submit">Mark resolved</button>
                        </form>
                        <form asp-action="Close" asp-route-id="@post.Id" method="post">
                            <input type="hidden" name="resolved" value="false" />
                            <button class="link-button" type="submit">Close report</button>
                        </form>
                    }
                </div>
            </article>
        }
      </div>
    </section>
</main>

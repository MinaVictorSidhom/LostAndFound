@model IEnumerable<LostAndFound.Ui.Models.Posts.InboxConversationViewModel>
@{
    ViewData["Title"] = "Messages";
}
<link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />

<main class="feed-page">
    <header class="feed-header">
        <a class="feed-brand" asp-action="Index"><span class="brand-mark">⌕</span>Lost &amp; Found</a>
        <nav><partial name="_ThemeToggle" /><a class="button-secondary" asp-action="MyPosts">My posts</a><a class="button-secondary messages-nav" data-messages-nav data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" asp-action="Inbox"><span>Messages</span><span class="message-notification" data-message-count hidden aria-hidden="true"></span></a></nav>
    </header>
    <section class="feed-hero compact">
        <div><p class="eyebrow">Your inbox</p><h1>Messages</h1><p>Continue conversations about lost and found reports.</p></div>
    </section>
    <section class="post-list" id="conversation-list" aria-label="Conversations" data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
        @if (!Model.Any())
        {
            <p class="empty-state">No messages yet.</p>
        }
        @foreach (var conversation in Model)
        {
            <article class="post-item conversation-card" data-post-id="@conversation.PostId" data-conversation-id="@conversation.ConversationId">
                <h2><span data-item-title>@conversation.ItemTitle</span><span class="conversation-unread" data-unread-count hidden></span></h2>
                <p data-latest-message>@conversation.LatestMessage</p>
                <p class="contact-note">@conversation.UpdatedAtUtc.ToLocalTime().ToString("g")</p>
                <a class="button-primary find-it-button" data-open-conversation data-conversation-id="@conversation.ConversationId" asp-action="Contact" asp-route-id="@conversation.PostId" asp-route-conversationId="@conversation.ConversationId">Open conversation</a>
            </article>
        }
    </section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="~/js/messages.js" asp-append-version="true"></script>

@using LostAndFound.Core.DTO
@model RegisterDTO
@{
    ViewData["Title"] = "Create your account";
}

<link rel="stylesheet" href="~/css/StyleSheet.css" />

<main class="auth-page">
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Lost and Found home">
        <span class="brand-mark" aria-hidden="true">⌕</span>
        <span>Lost &amp; Found</span>
    </a>

    <section class="auth-card auth-card-register" aria-labelledby="register-heading">
        <div class="auth-heading">
            <p class="eyebrow">Join the community</p>
            <h1 id="register-heading">Create your account</h1>
            <p>Report lost items, share finds, and help get belongings back where they belong.</p>
        </div>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

            <div class="field-group">
                <label asp-for="PersonName">Full name</label>
                <input asp-for="PersonName" autocomplete="name" placeholder="Enter your full name" />
                <span asp-validation-for="PersonName" class="validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="PhoneNumber">Phone number</label>
                <input asp-for="PhoneNumber" type="tel" autocomplete="tel" placeholder="Enter your phone number" />
                <span asp-validation-for="PhoneNumber" class="validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="new-password" placeholder="Create a password" />
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repeat your password" />
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>

            <button type="submit" class="auth-submit">Create account <span aria-hidden="true">→</span></button>
        </form>

        <p class="auth-footer">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
    </section>
</main>
